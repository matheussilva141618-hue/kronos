{
  "name": "kronos-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:mobile": "cross-env NEXT_MOBILE=1 next build && npx cap sync android",
    "open:android": "npx cap open android",
    "cognitive:loop": "npx tsx scripts/cognitive-worker.ts",
    "cognitive:loop:fast": "npx tsx scripts/cognitive-worker.ts --interval=60 --cycles=3",
    "cognitive:worker": "npx tsx scripts/cognitive-worker.ts",
    "cognitive:full": "npx tsx scripts/cognitive-worker.ts --full",
    "cognitive:full:fast": "npx tsx scripts/cognitive-worker.ts --full --interval=60 --cycles=2",
    "cognitive:python": "python scripts/kronos_agent.py",
    "cognitive:python:fast": "python scripts/kronos_agent.py --interval=60 --cycles=5",
    "proactive:worker": "npx tsx scripts/proactive-worker.ts",
    "proactive:worker:fast": "npx tsx scripts/proactive-worker.ts --interval=120 --cycles=5",
    "proactive:agentic": "npx tsx scripts/proactive-worker.ts --agentic",
    "kronos:core": "npx tsx scripts/cognitive-worker.ts --full & npx tsx scripts/proactive-worker.ts --agentic",
    "bridge": "python scripts/kronos_bridge.py",
    "bridge:install": "pip install psutil"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@cerebras/cerebras_cloud_sdk": "^1.19.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "@tailwindcss/typography": "^0.5.20",
    "@tavily/core": "^0.7.6",
    "@types/nodemailer": "^8.0.1",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.511.0",
    "next": "15.3.3",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
